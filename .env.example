# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# Payload CMS
PAYLOAD_SECRET=your-random-secret-at-least-32-chars

# S3-compatible storage (Cloudflare R2)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=bielanoc-media
S3_REGION=auto

# Public URL for media files.
# Production: use the R2 custom domain (CDN-cached, no rate limit):
NEXT_PUBLIC_S3_URL=https://media.bielanoc.sk
# Fallback (rate-limited, uncached — not for production):
# NEXT_PUBLIC_S3_URL=https://pub-YOUR_ID.r2.dev

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Facebook Pixel (optional)
NEXT_PUBLIC_FB_PIXEL_ID=

# Firebase Push Notifications (optional — JSON string of service account)
FIREBASE_SERVICE_ACCOUNT_JSON=
