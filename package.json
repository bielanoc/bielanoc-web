    "firebase-admin": "^13.9.0",
    "leaflet": "^1.9.4",
    "next": "^15.3.0",
    "payload": "^3.84.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
